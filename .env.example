# Provider API keys are entered by users at runtime in the browser.
# They are stored only in React state / sessionStorage unless a scheduled job is created.

# Required for Supabase-backed workflow features.
# Core agent runs work without these values.
VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Browser-side Resend key for test sends from the automations UI.
VITE_RESEND_API_KEY=your_resend_key

# Server-only (Vercel env, never prefix with VITE_).
# Required by api/cron/tick.js for scheduled autopilot runs.
CRON_SECRET=your_cron_secret
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
RESEND_API_KEY=your_resend_key
