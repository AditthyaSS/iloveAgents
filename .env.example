# Provider API keys are entered by users at runtime in the browser.
# They are stored only in React state / sessionStorage unless a scheduled job is created.

# Required for Supabase-backed workflow features.
# Core agent runs work without these values.
VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Server-only secrets (never use the VITE_ prefix for these, it would expose
# them in the browser bundle). Set these in the Vercel dashboard under
# Project Settings -> Environment Variables.
RESEND_API_KEY=your_resend_api_key
# Optional sender identity used by /api/send-automation-email.
# RESEND_FROM_EMAIL=Open Agents Hub <automations@openagentshub.dev>

