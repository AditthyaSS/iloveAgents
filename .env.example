
# ==========================================
# iloveAgents - Environment Configuration
# ==========================================

# Provider API keys
# Users enter their API keys at runtime through the application.
# Keys are stored in React state or sessionStorage.
# Do not commit actual API keys to GitHub.

# ==========================================
# Supabase Configuration
# ==========================================

# Required for Supabase-backed workflow features.
# Core AI agent functionality can run without Supabase.

# Your Supabase project URL
VITE_SUPABASE_URL=your_supabase_project_url

# Your Supabase anon/public key
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
