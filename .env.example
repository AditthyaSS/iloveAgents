# Provider API keys are entered by users at runtime in the browser.
# They are stored only in React state / sessionStorage unless a scheduled job is created.

# Optional local-dev fallback. Copy this file to .env and fill values.
# Never commit .env to version control. .gitignore already covers it.
# VITE_OPENAI_API_KEY=sk-...
# VITE_ANTHROPIC_API_KEY=sk-ant-...
# VITE_GEMINI_API_KEY=...
# VITE_OPENROUTER_API_KEY=...

# If a key leaks: revoke it in the provider dashboard, generate a new
# one, update .env, and clear sessionStorage in the browser.

# Required for Supabase-backed workflow features.
# Core agent runs work without these values.
VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
